# docker-compose.dev.yml 용 (선택). 없어도 로컬과 같은 기본값으로 기동한다.
# cp .env.dev.example .env

POSTGRES_DB=backend_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# VM 공인 IP로 OAuth 테스트 시에만 변경
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/v1/oauth/google/callback

ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=admin
ADMIN_NICKNAME=admin

# user-service, interaction-service Flyway (기본 true, 끄려면 false)
SPRING_FLYWAY_ENABLED=false
