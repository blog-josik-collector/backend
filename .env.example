# cp .env.example .env  후 값을 채운다. .env 는 커밋하지 않는다.

POSTGRES_DB=backend_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# scripts/backup-postgres.sh 로컬 dump 보관 일수 (VM cron에서 사용)
BACKUP_RETENTION_DAYS=7

# HS512용 64자 이상 권장
JWT_CLIENT_SECRET=change-me-to-a-long-secure-jwt-secret-at-least-64-characters-long

# Elasticsearch elastic 계정 (docker-compose.prod.yml — 최초 기동 시 ELASTIC_PASSWORD 로 설정됨)
ELASTICSEARCH_PASSWORD=change-me

# integrated-api 기동 시 ES alias 자동 생성 (compose environment 에서 컨테이너로 전달됨)
ELASTICSEARCH_PROVISIONING_ENABLED=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# VM에서 띄우면 http://공인IP:8000/auth/v1/oauth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/v1/oauth/google/callback

ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=change-me
ADMIN_NICKNAME=admin
