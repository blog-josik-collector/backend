{
  "settings": {
    "index": {
      "number_of_shards": 1,
      "number_of_replicas": 1
    },
    "analysis": {
      "analyzer": {
        "tech_blog_analyzer": {
          "type": "custom",
          "tokenizer": "nori_tech_tokenizer",
          "filter": [
            "lowercase",
            "nori_readingform",
            "tech_stop_filter"
          ]
        },
        "tech_blog_search_analyzer": {
          "type": "custom",
          "tokenizer": "nori_tech_tokenizer",
          "filter": [
            "lowercase",
            "nori_readingform",
            "tech_synonym_filter",
            "tech_stop_filter"
          ]
        }
      },
      "tokenizer": {
        "nori_tech_tokenizer": {
          "type": "nori_tokenizer",
          "decompound_mode": "mixed",
          "user_dictionary_rules_file": "techblog-user-dictionary.txt"
        }
      },
      "filter": {
        "tech_stop_filter": {
          "type": "nori_part_of_speech",
          "stoptags": [
            "E", "IC", "J", "MAG", "MAJ", "MM", "SP", "SSC", "SSO",
            "SC", "SE", "XPN", "XSA", "XSN", "XSV", "UNA", "NA", "VSV"
          ]
        },
        "tech_synonym_filter": {
          "type": "synonym_graph",
          "lenient": true,
          "synonyms_file": "techblog-synonyms.txt"
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "id": { "type": "keyword" },
      "provider": { "type": "keyword" },
      "title": {
        "type": "text",
        "analyzer": "tech_blog_analyzer",
        "search_analyzer": "tech_blog_search_analyzer",
        "fields": {
          "raw": { "type": "keyword" }
        }
      },
      "url": { "type": "keyword", "index": false, "doc_values": false },
      "publishedAt": { "type": "date", "format": "strict_date_optional_time||epoch_millis" },
      "thumbnailUrl": { "type": "keyword", "index": false, "doc_values": false },
      "summary": {
        "type": "text",
        "analyzer": "tech_blog_analyzer",
        "search_analyzer": "tech_blog_search_analyzer"
      },
      "status": { "type": "keyword" },
      "createdAt": { "type": "date", "format": "strict_date_optional_time||epoch_millis" },
      "updatedAt": { "type": "date", "format": "strict_date_optional_time||epoch_millis" },
      "likeCount": { "type": "integer" },
      "viewCount": { "type": "integer" },
      "commentCount": { "type": "integer" },
      "totalReportCount": { "type": "integer" }
    }
  }
}
