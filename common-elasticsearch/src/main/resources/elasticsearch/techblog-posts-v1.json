{
  "mappings": {
    "properties": {
      "id": { "type": "keyword" }, // DB의 UUID와 매칭, 문서 본문(Source) 안에 들어가는 데이터일 뿐
      "provider": { "type": "keyword" },
      "title": {
        "type": "text",
        "analyzer": "tech_blog_analyzer",
        "fields": {
          "raw": { "type": "keyword" } // 정규화되지 않은 원문 검색용
        }
      },
      "url": { "type": "keyword", "index": false, "doc_values": false }, // 검색 대상은 아님
      "publishedAt": {
        "type": "date",
        "format": "strict_date_optional_time||epoch_millis"
      },
      "thumbnailUrl": { "type": "keyword", "index": false, "doc_values": false }, // 검색 대상은 아님
      "summary": {
        "type": "text",
        "analyzer": "tech_blog_analyzer"
      },
      "status": { "type": "keyword" }, // status=true인 것만 검색하기 위함
      "createdAt": {
        "type": "date",
        "format": "strict_date_optional_time||epoch_millis"
      },
      "updatedAt": {
        "type": "date",
        "format": "strict_date_optional_time||epoch_millis"
      },
      /* ================= [CQRS를 위해 추가할 카운트 필드] ================= */
      "likeCount": {
        "type": "integer" // 추가된 카운트 필드 (Doc Values 자동 활성화)
      },
      "viewCount": {
        "type": "integer" // 추가된 카운트 필드 (Doc Values 자동 활성화)
      },
      "commentCount": {
        "type": "integer" // 추가된 카운트 필드 (Doc Values 자동 활성화)
      },
      "totalReportCount": {
        "type": "integer" // 추가된 카운트 필드 (Doc Values 자동 활성화)
      }
    }
  },
  "settings": {
    "index": {
      "number_of_shards": 1,
      "number_of_replicas": 1
    },
    "analysis": {
      "analyzer": {
        "tech_blog_analyzer": {
          "type": "custom",
          "tokenizer": "nori_tech_tokenizer",
          "filter": [
            "lowercase",
            "nori_readingform",
            "tech_stop_filter"
          ]
        }
      },
      "tokenizer": {
        "nori_tech_tokenizer": {
          "type": "nori_tokenizer",
          "decompound_mode": "mixed",
          "user_dictionary_rules": [
            "카카오뱅크", "라인플러스", "당근마켓", "쿠팡이츠",
            "스프링부트", "쿠버네티스", "레빗엠큐"
          ]
        }
      },
      "filter": {
        "tech_stop_filter": {
          "type": "nori_part_of_speech",
          "stoptags": ["E", "IC", "J", "MAG", "MAJ", "MM", "SP", "SSC", "SSO", "SC", "SE", "XPN", "XSA", "XSN", "XSV", "UNA", "NA", "VSV"]
        }
      }
    }
  }
}